{
  "schemaVersion": 3,
  "id": "l4d2.interactive",
  "name": "L4D2 Interactive",
  "version": "0.1.0",
  "description": "Drive a Left 4 Dead 2 dedicated server over RCON: connection check, common hordes, special infected, and items. No plugin UI code runs in the host beyond this manifest: the process backend owns the RCON protocol.",
  "longDescription": "Drive a Left 4 Dead 2 dedicated server over RCON: test the connection, spawn common hordes, spawn special infected (tank, witch, smoker, boomer, hunter, spitter, jockey, charger), and drop items.\n\n- Direct RCON path only: no game-server mods beyond the SourceMod adapter (verified live on SRCDS; see integrations/l4d2/README.md for the gate evidence and the hibernation boundary)\n- Strict allowlists and bounds on every action; the RCON password stays in host-managed settings and never appears in logs\n- Rate limited with per-action timeouts; spawn outcomes report what the game confirmed, never just what was sent",
  "icon": "server",
  "tags": ["l4d2", "game", "rcon", "server"],
  "runtime": "process",
  "entry": "tiktools-l4d2",
  "protocolVersion": 1,
  "capabilities": [],
  "permissions": [],
  "actionTypes": [
    {
      "id": "l4d2.test_connection",
      "version": 1,
      "title": {"default": "Test connection"},
      "description": {"default": "Authenticate over RCON and read game state. No spawns, no side effects."},
      "tag": "l4d2",
      "icon": "connected",
      "category": "Connection",
      "requiredCapabilities": [],
      "timeoutMs": 15000,
      "fields": []
    },
    {
      "id": "l4d2.spawn_common",
      "version": 1,
      "title": {"default": "Spawn common horde"},
      "description": {"default": "Spawn common infected near the survivors."},
      "tag": "l4d2",
      "icon": "users",
      "category": "Spawning",
      "requiredCapabilities": [],
      "timeoutMs": 15000,
      "fields": [
        {
          "key": "count",
          "label": {"default": "Count"},
          "kind": "number",
          "value": "5",
          "min": 1,
          "max": 25,
          "hint": {"default": "The game adapter enforces its own cap (default 10) and reports how many actually spawned."}
        }
      ]
    },
    {
      "id": "l4d2.spawn_infected",
      "version": 1,
      "title": {"default": "Spawn special infected"},
      "description": {"default": "Spawn one special infected type near the survivors."},
      "tag": "l4d2",
      "icon": "warning",
      "category": "Spawning",
      "requiredCapabilities": [],
      "timeoutMs": 15000,
      "fields": [
        {
          "key": "class",
          "label": {"default": "Class"},
          "kind": "select",
          "value": "tank",
          "options": [
            {"value": "tank", "label": {"default": "Tank"}},
            {"value": "witch", "label": {"default": "Witch"}},
            {"value": "smoker", "label": {"default": "Smoker"}},
            {"value": "boomer", "label": {"default": "Boomer"}},
            {"value": "hunter", "label": {"default": "Hunter"}},
            {"value": "spitter", "label": {"default": "Spitter"}},
            {"value": "jockey", "label": {"default": "Jockey"}},
            {"value": "charger", "label": {"default": "Charger"}}
          ]
        },
        {
          "key": "count",
          "label": {"default": "Count"},
          "kind": "number",
          "value": "1",
          "min": 1,
          "max": 8,
          "hint": {"default": "Tanks are limited to 1 per call with a cooldown between calls."}
        }
      ]
    },
    {
      "id": "l4d2.spawn_item",
      "version": 1,
      "title": {"default": "Spawn item"},
      "description": {"default": "Drop an item near the survivors."},
      "tag": "l4d2",
      "icon": "gift",
      "category": "Items",
      "requiredCapabilities": [],
      "timeoutMs": 15000,
      "fields": [
        {
          "key": "item",
          "label": {"default": "Item"},
          "kind": "select",
          "value": "first_aid_kit",
          "options": [
            {"value": "first_aid_kit", "label": {"default": "First aid kit"}},
            {"value": "pain_pills", "label": {"default": "Pain pills"}},
            {"value": "adrenaline", "label": {"default": "Adrenaline"}},
            {"value": "pipe_bomb", "label": {"default": "Pipe bomb"}},
            {"value": "molotov", "label": {"default": "Molotov"}},
            {"value": "defibrillator", "label": {"default": "Defibrillator"}}
          ]
        },
        {
          "key": "count",
          "label": {"default": "Count"},
          "kind": "number",
          "value": "1",
          "min": 1,
          "max": 5
        }
      ]
    }
  ],
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "title": "RCON host",
          "description": "Game server address. Prefer 127.0.0.1 (same machine); RCON has no encryption.",
          "default": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "title": "RCON port",
          "description": "Server RCON port (default 27015).",
          "minimum": 1,
          "maximum": 65535,
          "default": 27015
        },
        "password": {
          "type": "string",
          "title": "RCON password",
          "description": "Server rcon_password. Stored in host-managed settings and never logged.",
          "secret": true
        },
        "timeoutMs": {
          "type": "integer",
          "title": "RCON timeout (ms)",
          "description": "Per-operation socket timeout. Keep well under the 15s action timeout.",
          "minimum": 2000,
          "maximum": 12000,
          "default": 8000
        },
        "maxPerMinute": {
          "type": "integer",
          "title": "Max actions per minute",
          "description": "Global RCON rate limit across all L4D2 actions.",
          "minimum": 1,
          "maximum": 120,
          "default": 30
        }
      },
      "required": ["host", "port", "password"]
    },
    "uiHints": {
      "fields": {
        "host": {
          "placeholder": "127.0.0.1"
        },
        "port": {
          "placeholder": "27015"
        },
        "password": {
          "secret": true,
          "placeholder": "rcon_password value"
        },
        "timeoutMs": {
          "advanced": true
        },
        "maxPerMinute": {
          "advanced": true
        }
      }
    }
  }
}
