{
  "name": "tiktok-live-appv3",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test src",
    "test:plugin-worker": "bun run src/automation/plugins/worker-smoke.ts",
    "build:plugins": "bun run scripts/build-plugins.ts",
    "package:plugin": "bun run scripts/package-plugin.ts",
    "install:plugin": "bun run scripts/install-plugin.ts",
    "smoke:compiled": "bun run scripts/smoke-compiled.ts",
    "smoke:compiled-worker": "bun run scripts/smoke-compiled-worker.ts",
    "smoke:compiled-integration": "bun run scripts/smoke-compiled-integration.ts",
    "build:host": "bun run scripts/build-host.ts",
    "build:exe": "bun run scripts/build-exe.ts",
    "build:exe:all": "bun run scripts/build-exe.ts all",
    "verify:exe": "bun run build:host && bun run build:exe && bun run smoke:compiled && bun run smoke:compiled-worker && bun run smoke:compiled-integration"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "napi-vm": "0.1.4",
    "preact": "^10.29.8",
    "sqlite-napi": "^1.3.0",
    "tray-icon-node": "^0.1.2",
    "webview-napi": "^2.2.0"
  }
}
