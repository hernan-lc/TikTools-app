{
  "name": "tiktok-live-appv3",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test src",
    "test:plugin-worker": "bun run src/automation/plugins/worker-smoke.ts",
    "smoke:compiled": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-compiled.ps1",
    "smoke:compiled-worker": "bun run scripts/smoke-compiled-worker.ts",
    "build:host": "bun run scripts/build-host.ts",
    "build:exe": "bun run scripts/build-exe.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "napi-vm": "0.1.4",
    "preact": "^10.29.8",
    "sqlite-napi": "^1.3.0",
    "tray-icon-node": "^0.1.2",
    "webview-napi": "^2.2.0"
  },
  "optionalDependencies": {
    "miniaudio_node": "^1.6.0"
  }
}
