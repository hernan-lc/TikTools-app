{
  "name": "tiktok-live-appv3",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run build:web && cargo run -p tiktools-desktop",
    "start:rust": "cargo run -p tiktools-desktop",
    "dev": "bun run serve:web",
    "build:web": "bun run scripts/build-web.ts",
    "serve:web": "bun run scripts/serve-web.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test src/web src/automation",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace",
    "build:desktop": "cargo build -p tiktools-desktop --release"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
