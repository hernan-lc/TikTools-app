{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universal-widget.local/v1/event.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(?:[.][a-z0-9_-]+)+$"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(?:[.][a-z0-9_-]+)+$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]{3})?Z$"
    },
    "data": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "originInstance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hopCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "room": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "legacy": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "source",
    "type",
    "timestamp",
    "data"
  ],
  "additionalProperties": false
}
